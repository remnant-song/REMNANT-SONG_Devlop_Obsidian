{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://remnant-song.dev/schemas/frontmatter.schema.json",
  "title": "Post Frontmatter Schema",
  "description": "博客文章 Frontmatter 字段定义，用于内容仓校验和网站仓内容建模",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "文章标题，优先于正文 H1 使用"
    },
    "date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "description": "发布日期，格式 YYYY-MM-DD"
    },
    "updated": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "description": "最后修改日期，格式 YYYY-MM-DD"
    },
    "excerpt": {
      "type": "string",
      "description": "文章摘要，用于列表卡片和 SEO description"
    },
    "tags": {
      "type": "array",
      "items": { "type": "string" },
      "description": "标签列表，扁平化结构支持交叉分类"
    },
    "category": {
      "type": "string",
      "description": "文章分类，优先于目录结构推断"
    },
    "draft": {
      "type": "boolean",
      "default": false,
      "description": "是否为草稿，草稿在非调试模式下不展示"
    },
    "hidden": {
      "type": "boolean",
      "default": false,
      "description": "是否隐藏，隐藏文章不在列表中显示但可通过直接链接访问"
    },
    "pin": {
      "type": "integer",
      "minimum": 0,
      "description": "置顶权重，数值越大越靠前，0 为普通排序"
    },
    "cover": {
      "type": "string",
      "format": "uri",
      "description": "封面图 URL，用于列表卡片和 OG 图片"
    },
    "author": {
      "type": "string",
      "description": "作者名，默认取站点配置"
    },
    "audio": {
      "type": "string",
      "format": "uri",
      "description": "音频资源 URL（扩展字段，用于富媒体文章）"
    },
    "score": {
      "type": "string",
      "format": "uri",
      "description": "乐谱资源 URL（扩展字段）"
    },
    "model": {
      "type": "string",
      "format": "uri",
      "description": "3D 模型资源 URL（扩展字段）"
    },
    "attachments": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": { "type": "string" },
          "url": { "type": "string", "format": "uri" },
          "type": { "type": "string" }
        }
      },
      "description": "附件列表（扩展字段）"
    }
  },
  "required": ["title", "date"],
  "additionalProperties": false
}